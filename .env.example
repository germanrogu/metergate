# Postgres
DATABASE_URL=postgres://metergate_app:metergate_app@db:5432/metergate
MIGRATIONS_DATABASE_URL=postgres://metergate_migrator:metergate_migrator@db:5432/metergate

# Redis
REDIS_URL=redis://redis:6379

# App
NODE_ENV=development
PORT=3000

# Secrets (never commit real values)
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-base64-key
JWT_PLATFORM_ADMIN_SECRET=replace-with-random-secret

# Stripe (test mode only)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# Provider mode: mock | live
LLM_MODE=mock
